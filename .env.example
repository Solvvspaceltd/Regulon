# --- Server hosting (Vercel, Node host) ---------------------------------------
# Where /api/waitlist forwards early-access sign-ups (JSON POST: email, audience,
# source, at). Kept server-side, so the URL is never exposed to visitors.
# Leave unset and the form tells visitors sign-up isn't open yet.
WAITLIST_WEBHOOK_URL=

# --- Static hosting (GitHub Pages) -------------------------------------------
# Set as a repository VARIABLE named WAITLIST_URL (not in this file); the Pages
# workflow passes it in at build time. The browser posts straight to it, so it
# is visible in the page source. See README, "Sign-up form".
# NEXT_PUBLIC_WAITLIST_URL=
